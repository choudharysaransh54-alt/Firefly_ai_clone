# Environment variables for the backend — all optional. Export them before starting
# uvicorn (e.g. `export ANTHROPIC_API_KEY=...`) or set them in your hosting dashboard.

# SQLite file location. Defaults to backend/fireflies.db
# DATABASE_URL=sqlite:///./fireflies.db

# Comma-separated list of allowed frontend origins. Defaults to "*".
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Enables Claude-generated summaries and AskFred answers. Without it, the rule-based
# summarizer and assistant are used, so the app works fully offline.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
